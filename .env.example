# Local, single-owner installation. setup_windows.ps1 creates .env.
DATABASE_URL=sqlite:///storage/clip_tribune.db
# Full infrastructure: postgresql+psycopg://tribune:tribune_local@127.0.0.1:54329/tribune
REDIS_URL=
STORAGE_ROOT=storage
FFMPEG_PATH=
FFPROBE_PATH=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
YOUTUBE_API_KEY=
# Desktop OAuth client, loopback redirect
OAUTH_REDIRECT_URI=http://127.0.0.1:8765/api/youtube/callback
AI_API_URL=
AI_API_KEY=
AI_MODEL=
# Optional HTTP speech worker, see docs/providers.md
SPEECH_API_URL=
SPEECH_API_KEY=
